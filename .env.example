# PostgreSQL for local development only.
# Copy this file to .env; never commit .env or a real password.
POSTGRES_DB=roam_dev
POSTGRES_USER=roam_dev
POSTGRES_PORT=5432

# Required: generate a unique local password, for example with:
# openssl rand -hex 32
# Paste the generated value below in your .env, not in this example file.
POSTGRES_PASSWORD=

# POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD initialize an empty volume.
# Editing them later does not change an existing database or its credentials.
# The current FastAPI health endpoint does not require these variables.

# Backend connection (required only when using database features).
# Load explicitly from backend/: uv run --env-file ../.env --locked <command>
# Format: postgresql+psycopg://<user>:<password>@127.0.0.1:<published-port>/<database>
# Use your own ignored local value, URL-encoding reserved credential characters.
# Remote hosts require sslmode=verify-full and trusted certificate configuration.
DATABASE_URL=

# Optional integration-test administrator URL. Tests NEVER fall back to DATABASE_URL.
# Must target the local "postgres" maintenance database, not roam_dev.
# Format: postgresql+psycopg://<test-admin>:<password>@127.0.0.1:<published-port>/postgres
# The test role needs CREATEDB; tests create/drop only their own UUID-named databases.
# Tests also require the explicit --run-db-tests option.
TEST_DATABASE_ADMIN_URL=
